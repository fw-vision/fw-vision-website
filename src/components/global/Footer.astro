---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getCollection } from "astro:content";
import { formatCategoryLabel, topCategoriesFrom } from "@/data/categories";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const allTags = allPosts.flatMap((post) => post.data.tags);
const categories = topCategoriesFrom(allTags);

const sections = [
  {
    title: "FW.VISION",
    links: [
      { name: "About", url: "/about" },
      { name: "Engage", url: "/contact" },
      { name: "Subscribe", url: "/subscribe" },
    ],
  },
  {
    title: "Research",
    links: [
      { name: "Insights", url: "/blog" },
      { name: "Signals", url: "/signals" },
      { name: "Trajectory Storylines", url: "/storylines" },
      { name: "Lexicon", url: "/lexicon" },
      { name: "Tools", url: "/tools" },
    ],
  },
  {
    title: "Categories",
    links: [
      ...categories.map((tag) => ({
        name: formatCategoryLabel(tag),
        url: `/blog/tags/${tag}`,
      })),
      { name: "View all", url: "/blog/tags" },
    ],
  },
  {
    title: "Connect",
    links: [
      { name: "Twitter/X", url: "https://x.com/fikiCI" },
      { name: "LinkedIn", url: "https://linkedin.com/in/congwang" },
      { name: "RSS Feed", url: "/rss.xml" },
    ],
  },
];
---

<footer class="bg-base-950">
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-6 gap-8 lg:gap-12">
      <div class="lg:col-span-2 order-last">
        <Text tag="h3" variant="textBase" class="text-white font-display font-medium">FW.VISION publications</Text>
        <Text tag="p" variant="textXS" class="text-base-400 mt-2">
          Subscribe to Signals for cross-domain futures analysis. Research, commentary, and scenarios remain openly available on this site.
        </Text>
        <Text tag="a" variant="textXS" href="/subscribe" class="mt-4 inline-block text-white hover:underline">Subscribe to Signals</Text>
      </div>
      <div
        class="grid gap-4 lg:gap-8 grid-cols-2 lg:grid-cols-4 lg:col-span-4 gap-y-12"
      >
        {
          sections.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="textXS"
                class="flex gap-x-2 text-white justify-between uppercase font-medium"
              >
                {section.title}
              </Text>
              <ul
                role="list"
                class="mt-2 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4"
              >
                {section.links.map((link) => (
                  <li>
                    <Text
                      tag="a"
                      variant="textXS"
                      class="text-base-400 hover:underline capitalize"
                      href={link.url}
                    >
                      {link.name}
                    </Text>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="mt-42 lg:mt-62 relative before:absolute after:absolute before:bg-white after:bg-white/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4"
    >
      <Text tag="p" variant="textXS" class="text-base-600">
        © {new Date().getFullYear()} FW.VISION Futures Thinking Inc. · 先见之明 远景智库导报 有限公司 · <a class="hover:underline" href="/legal/privacy">Privacy</a> · <a class="hover:underline" href="/legal/terms">Terms</a> · <a class="hover:underline" href="/legal/source-attribution">Editorial standards</a>
      </Text>
    </div>
  </Wrapper>
</footer>
