---
// FW.VISION self-promotion card (replaces the template's Lexington ad slot).
// Aside placement: subscribe to the foresight brief.
import Text from "@/components/fundations/elements/Text.astro";
---

<div class="relative w-full overflow-hidden rounded-xl mt-6 bg-base-950 p-6">
  <Text tag="p" variant="textXS" class="uppercase tracking-[0.18em] text-accent-400 font-medium">
    Subscribe to Signals
  </Text>
  <Text tag="h3" variant="textLG" class="text-white font-display font-medium mt-3">
    Foresight, in your inbox.
  </Text>
  <Text tag="p" variant="textXS" class="text-base-400 mt-2">
    Cross-domain futures analysis and framework updates, published when substance
    warrants it, not on a fixed schedule.
  </Text>
  <a
    href="/subscribe"
    class="mt-4 inline-flex items-center px-4 py-2 text-xs font-medium text-white rounded-lg bg-accent-700"
  >
    Subscribe
  </a>
</div>
