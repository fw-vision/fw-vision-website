---
import Text from "@/components/fundations/elements/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard1 from "@/components/blog/BlogCard1.astro";
import { getCollection } from "astro:content";
import { postUrl } from "@/utils/postUrl";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const columns = allPosts
  .filter(
    (post) =>
      post.data.contentType === "column" &&
      post.data.editorialStatus === "published",
  )
  .slice(0, 4);

const lead = columns[0];
---

<div>
  <Text
    tag="a"
    variant="textXS"
    href="/commentary"
    class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
  >
    Commentary<span
      class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case"
      >All columns <ChevronRight class="size-4" /></span
    >
  </Text>
  <div
    class="flex flex-col gap-6 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
  >
    {
      lead ? (
        <a href={postUrl(lead)} class="group block">
          <Text
            tag="h3"
            variant="textBase"
            class="text-base-900 font-display group-hover:underline"
          >
            {lead.data.title}
          </Text>
          <Text tag="p" variant="textXS" class="text-base-600 mt-2">
            {lead.data.description}
          </Text>
        </a>
      ) : (
        <Text tag="p" variant="textXS" class="text-base-600">
          Commentary columns will appear here.
        </Text>
      )
    }
    {
      columns.slice(1).length > 0 && (
        <div class="flex flex-col gap-8">
          {columns.slice(1).map((post) => (
            <BlogCard1 post={post} />
          ))}
        </div>
      )
    }
  </div>
</div>
