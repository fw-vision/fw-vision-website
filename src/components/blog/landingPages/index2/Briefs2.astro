---
import Text from "@/components/fundations/elements/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard1 from "@/components/blog/BlogCard1.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const signals = allPosts
  .filter(
    (post) =>
      post.data.contentType === "signal" &&
      post.data.editorialStatus === "published",
  )
  .slice(0, 3);
---

{signals.length > 0 && (
  <div>
    <Text
      tag="a"
      variant="textXS"
      href="/signals"
      class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
    >
      Signals<span
        class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case"
        >See all <ChevronRight class="size-4" /></span
      >
    </Text>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
    >
      {signals.map((post) => <BlogCard1 post={post} />)}
    </div>
  </div>
)}
