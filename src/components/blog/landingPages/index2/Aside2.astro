---
import Text from "@/components/fundations/elements/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard3 from "@/components/blog/BlogCard3.astro";
import BlogCard5 from "@/components/blog/BlogCard5.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const innovationPosts = allPosts
  .filter((post) => post.data.tags.includes("innovation") && !post.data.isFeatured)
  .slice(0, 4);

const lead = innovationPosts[0];
const rest = innovationPosts.slice(1, 4);
---

{innovationPosts.length > 0 && (
  <div>
    <Text
      tag="a"
      variant="textXS"
      href="/blog/tags/innovation"
      class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
    >
      Innovation<span
        class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case"
        >More <ChevronRight class="size-4" /></span
      >
    </Text>
    <div
      class="flex flex-col gap-6 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
    >
      {lead && <BlogCard3 post={lead} />}
      {rest.length > 0 && (
        <div class="flex flex-col gap-4">
          {rest.map((post) => <BlogCard5 post={post} />)}
        </div>
      )}
    </div>
  </div>
)}
