---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard5 from "@/components/blog/BlogCard5.astro";
import BlogCard4 from "@/components/blog/BlogCard4.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.editorialStatus === "published")
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });

// Sovereignty band — inverted Phanatik Tech layout (list left, large card right)
const posts = allPosts.filter((post) => post.data.tags.includes("sovereignty"));
const side = posts.slice(0, 3);
const lead = posts[3] ?? posts[0];
---

{
  posts.length > 0 && (
    <div>
      <Text
        tag="a"
        variant="textXS"
        href="/blog/tags/sovereignty"
        class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
      >
        Sovereignty
        <span class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case">
          See all <ChevronRight class="size-4" />
        </span>
      </Text>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
      >
        <div class="mt-2 flex flex-col gap-4 lg:col-span-1 order-first">
          {side.map((post) => (
            <BlogCard5 post={post} />
          ))}
        </div>
        {lead && (
          <div class="lg:col-span-3 col-span-full">
            <BlogCard4 post={lead} />
          </div>
        )}
      </div>
    </div>
  )
}
