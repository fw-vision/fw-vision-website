---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Entries
import BlogCard5 from "@/components/blog/BlogCard5.astro";
// Get all posts
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

// Show foresight-tagged posts not already featured
const foresightPosts = allPosts
  .filter((post) => post.data.tags.includes("foresight") && !post.data.isFeatured)
  .slice(0, 4);
---

{foresightPosts.length > 0 && (
  <div>
    <Text
      tag="a"
      variant="textXS"
      href="/blog/tags/foresight"
      class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
    >
      Foresight<span
        class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case"
        >More <ChevronRight class="size-4" /></span
      >
    </Text>

    <div
      class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
    >
      <div
        class="flex flex-col gap-4 border-b border-base-200 divide-y divide-base-200"
      >
        {foresightPosts.map((post) => <BlogCard5 post={post} />)}
      </div>
    </div>
  </div>
)}
