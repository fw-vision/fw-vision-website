---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Entries
import BlogCard5 from "@/components/blog/BlogCard5.astro";
// Get all posts
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

// Briefs: posts marked isBrief, excluding anything already featured or in top stories
const briefs = allPosts
  .filter((post) => post.data.isBrief && !post.data.isFeatured && !post.data.isTopStory)
  .slice(0, 4);
---

{briefs.length > 0 && (
  <div>
    <Text
      tag="h2"
      variant="textXS"
      class="text-base-900 uppercase font-medium"
    >
      Signal Briefs
    </Text>
    <div
      class="flex flex-col gap-4 mt-2 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4"
    >
      {briefs.map((post) => <BlogCard5 post={post} />)}
    </div>
  </div>
)}
