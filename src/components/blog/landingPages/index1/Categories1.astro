---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard5 from "@/components/blog/BlogCard5.astro";
import { getCollection } from "astro:content";
import { PRIMARY_CATEGORIES, formatCategoryLabel } from "@/data/categories";

const allPosts = (await getCollection("posts"))
  .filter((post) => post.data.editorialStatus === "published")
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate).getTime();
    const dateB = new Date(b.data.pubDate).getTime();
    return dateB - dateA;
  });

const claimed = new Set<string>();
const categories = PRIMARY_CATEGORIES.map((tag) => {
  const posts = allPosts
    .filter((post) => post.data.tags.includes(tag) && !claimed.has(post.id))
    .slice(0, 4);
  for (const post of posts) claimed.add(post.id);
  return {
    name: formatCategoryLabel(tag),
    tag,
    posts,
  };
}).filter((category) => category.posts.length > 0);
---

<section>
  <Wrapper variant="standard" class="py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 lg:gap-y-24">
      {
        categories.map((category) => (
          <div>
            <Text
              tag="a"
              variant="textXS"
              href={`/blog/tags/${category.tag}`}
              class="flex gap-x-2 text-base-900 justify-between uppercase font-medium capitalize"
            >
              {category.name}
              <span class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case">
                More <ChevronRight class="size-4" />
              </span>
            </Text>
            <div class="flex flex-col mt-2 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4">
              {category.posts.map((post) => (
                <BlogCard5 post={post} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
