---
import Text from "@/components/fundations/elements/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import BlogCard3 from "@/components/blog/BlogCard3.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const topStories = allPosts
  .filter((post) => post.data.isTopStory && !post.data.isFeatured)
  .slice(0, 3);
---

{topStories.length > 0 && (
  <div>
    <Text
      tag="a"
      variant="textXS"
      href="/blog"
      class="flex gap-x-2 text-base-900 justify-between uppercase font-medium"
    >
      Latest<span
        class="text-base-600 hover:text-base-900 flex items-center gap-2 normal-case"
        >All insights <ChevronRight class="size-4" /></span
      >
    </Text>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-2 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4"
    >
      {topStories.map((post) => <BlogCard3 post={post} />)}
    </div>
  </div>
)}
