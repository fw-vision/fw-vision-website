---
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import readingTime from "reading-time";
import { postUrl } from "@/utils/postUrl";

const post = Astro.props.post;
const { url, title, pubDate, image } = {
  url: postUrl(post),
  title: post.data.title,
  image: post.data.image?.url,
  pubDate: new Date(post.data.pubDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  }),
};

const stats = readingTime(post.body);
---

<article class="relative flex flex-col group overflow-hidden rounded-xl">
  <a href={url} title={title} class="absolute inset-0 z-30"></a>

  {image ? (
    <Image
      src={image}
      alt={title}
      width={1200}
      height={675}
      loading="eager"
      decoding="async"
      class="object-cover w-full aspect-16/9 max-h-[60vh]"
    />
  ) : (
    <div class="w-full aspect-16/9 max-h-[60vh] bg-gradient-to-br from-accent-800 to-accent-950"></div>
  )}

  <div
    class="absolute inset-0 bg-gradient-to-t from-base-950/90 via-base-950/30 to-transparent z-10"
  >
  </div>

  <div class="absolute bottom-0 left-0 right-0 z-20 p-5 lg:p-6">
    <Text tag="p" variant="textXS" class="text-base-200">
      <time datetime={pubDate}>{pubDate}</time>
      <span aria-hidden="true">&middot;</span>
      {stats.text}
    </Text>
    <Text
      tag="h3"
      variant="displaySM"
      class="mt-1 text-base-50 group-hover:underline font-display text-balance"
    >
      {title}
    </Text>
  </div>
</article>
