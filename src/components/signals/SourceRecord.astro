---
interface SourceRecord {
  publisher: string;
  title: string;
  url: string;
  publishedAt: Date;
  accessedAt: Date;
  sourceType?: string;
}

const { sourceRecord } = Astro.props as { sourceRecord: SourceRecord };
---

<section class="border-t border-base-200 pt-5">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-base-900">Source record</h2>
  <a class="mt-3 block text-sm font-medium text-accent-700 hover:underline" href={sourceRecord.url} rel="external noopener" target="_blank">{sourceRecord.publisher}: {sourceRecord.title}</a>
  <p class="mt-2 text-xs text-base-600">Published {sourceRecord.publishedAt.toLocaleString("en-CA")}</p>
  <p class="text-xs text-base-600">Accessed {sourceRecord.accessedAt.toLocaleString("en-CA")}</p>
</section>
