---
const title = "FW.VISION | Futures Thinking and Sovereign Innovation";
const description = "FW.VISION Futures Thinking Inc. publishes source-attributed signals, signed commentary, and futures scenarios for sovereign innovation.";
const canonical = new URL(Astro.url.pathname, "https://fw.vision").href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="FW.VISION" />
<meta property="og:locale" content="en_CA" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
