---
import { AstroSeo } from "@lexingtonthemes/seo";
---

<AstroSeo
  title="FW.VISION — Institutional Foresight Architecture"
  description="A founder-led AI-native think tank publishing research, frameworks, and futures scenarios for sovereign innovation and long-horizon institutional design."
  canonical="https://fw.vision"
  openGraph={{
    url: "https://fw.vision",
    title: "FW.VISION — Institutional Foresight Architecture",
    description: "A founder-led AI-native think tank publishing research, frameworks, and futures scenarios for sovereign innovation and long-horizon institutional design.",
    images: [
      {
        url: "https://fw.vision/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "FW.VISION — Institutional Foresight Architecture",
        type: "image/jpeg",
      },
    ],
    site_name: "FW.VISION",
    type: "website",
    locale: "en_CA",
  }}
  twitter={{
    handle: "@fikiCI",
    site: "@fikiCI",
    cardType: "summary_large_image",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://fw.vision" />
<meta property="og:title" content="FW.VISION — Institutional Foresight Architecture" />
<meta
  property="og:description"
  content="A founder-led AI-native think tank publishing research, frameworks, and futures scenarios for sovereign innovation."
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://fw.vision" />
<meta property="twitter:title" content="FW.VISION — Institutional Foresight Architecture" />
<meta
  property="twitter:description"
  content="A founder-led AI-native think tank publishing research, frameworks, and futures scenarios for sovereign innovation."
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://fw.vision" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
