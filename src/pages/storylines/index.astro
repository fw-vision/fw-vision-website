---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const all = await getCollection("storylines");
const statusOrder = { showcase: 0, active: 1, "coming-soon": 2 };
all.sort((a, b) => (statusOrder[a.data.status] ?? 3) - (statusOrder[b.data.status] ?? 3));

// Horizon facets for filtering.
const HORIZONS = ["H1", "H2", "H3", "H4"];
const statusLabel = { showcase: "Showcase", active: "Active", "coming-soon": "Coming soon" };
---

<BaseLayout>
  <section class="border-b border-base-200">
    <Wrapper variant="standard" class="py-12">
      <Text tag="p" variant="textXS" class="text-base-500 uppercase tracking-[0.18em] font-medium">
        Trajectory Storylines
      </Text>
      <Text tag="h1" variant="displayMD" class="text-base-900 font-display mt-4 max-w-3xl">
        The futures within our range of concern.
      </Text>
      <Text tag="p" variant="textSM" class="text-base-600 mt-5 max-w-2xl">
        Each storyline is a named preferred trajectory through a sequence of scenarios, with the
        off-ramps that would derail it. Classified by Foresight Scope likelihood and searchable by
        horizon of concern.
      </Text>

      <div class="mt-8 flex flex-wrap items-center gap-2" data-horizon-filter>
        <Text tag="span" variant="textXS" class="text-base-500 mr-1">Horizon of concern:</Text>
        <button data-h="all" class="hz-btn is-active border border-base-300 px-3 py-1 text-xs" type="button">All</button>
        {HORIZONS.map((h) => (
          <button data-h={h} class="hz-btn border border-base-300 px-3 py-1 text-xs" type="button">{h}</button>
        ))}
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 gap-px bg-base-200 md:grid-cols-2 lg:grid-cols-3" data-storyline-grid>
        {
          all.map((s) => (
            <a
              href={`/storylines/${s.id}`}
              class="storyline-card group bg-base-50 transition-colors hover:bg-base-100 overflow-hidden"
              data-horizons={s.data.horizons.join(",")}
            >
              {s.data.cover && (
                <div class="aspect-12/8 w-full overflow-hidden">
                  <Image
                    src={s.data.cover.url as any}
                    alt={s.data.cover.alt}
                    width={800}
                    height={533}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center justify-between">
                  <Text tag="span" variant="textXS" class="uppercase tracking-[0.15em] font-medium" style="color: var(--color-accent-600);">
                    {statusLabel[s.data.status] ?? s.data.status}
                  </Text>
                  <Text tag="span" variant="textXS" class="text-base-400">
                    {s.data.horizons.join(" \u00b7 ")}
                  </Text>
                </div>
                <Text tag="h2" variant="textLG" class="text-base-900 font-display font-medium mt-3">
                  {s.data.slogan}
                </Text>
                <Text tag="p" variant="textXS" class="text-base-600 mt-2">
                  {s.data.description}
                </Text>
                <div class="mt-4 flex flex-wrap gap-2">
                  {s.data.domainSeries.map((d) => (
                    <Text tag="span" variant="textXS" class="text-base-400">{d}</Text>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll("[data-horizon-filter] .hz-btn");
    const cards = document.querySelectorAll("[data-storyline-grid] .storyline-card");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const h = btn.getAttribute("data-h");
        buttons.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        cards.forEach((card) => {
          const hz = (card.getAttribute("data-horizons") || "").split(",");
          const show = h === "all" || hz.some((x) => x.startsWith(h));
          card.style.display = show ? "" : "none";
        });
      });
    });
  })();
</script>

<style>
  .hz-btn.is-active {
    background: var(--color-accent-700);
    color: white;
    border-color: var(--color-accent-700);
  }
</style>
