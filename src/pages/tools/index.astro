---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { ForesightScope } from "@fw-vision/widgets";
import "@fw-vision/widgets/style.css";
import { foresightDataForStoryline } from "@/data/foresight-graph/derive";

const showcaseScope = foresightDataForStoryline("sl-sovereign-canada");
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-8">
        <div class="lg:pr-8">
          <div class="lg:sticky lg:top-20">
            <Text tag="h1" variant="textBase" class="text-base-900 font-display font-medium">
              Interactive Tools
            </Text>
            <div
              class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
            >
              <Text tag="p" variant="textSM" class="text-base-600">
                Live foresight visualisation and CITAble Business assessment instruments from the
                fw-vision-dataviz toolkit.
              </Text>
            </div>
            <div
              class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-6"
            >
              <Text tag="h3" variant="textSM" class="text-base-900 font-medium font-display">
                CITAble Business Explorer
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 mt-2">
                Interactive reading of the CITAble Business Index is in progress. Methodology is
                published now; the embed ships when the widget is wired.
              </Text>
              <Text
                tag="a"
                variant="textXS"
                href="/lexicon/citable-business-index"
                class="inline-block mt-3 text-accent-600 hover:underline"
              >
                CITAble Business Index &rarr;
              </Text>
            </div>
          </div>
        </div>
        <div
          class="lg:col-span-2 lg:pl-8 lg:relative lg:before:absolute lg:after:absolute
            lg:before:bg-base-950 lg:after:bg-base-950/10 lg:before:top-0
            lg:before:left-0 lg:before:h-6 lg:before:w-px lg:after:top-8
            lg:after:bottom-0 lg:after:left-0 after:w-px"
        >
          <Text tag="p" variant="textXS" class="text-base-900 uppercase font-medium tracking-[0.18em]">
            Foresight Scope
          </Text>
          <Text tag="h2" variant="displaySM" class="text-base-900 font-display mt-3 max-w-2xl">
            The futures within our range of concern.
          </Text>
          <Text tag="p" variant="textSM" class="text-base-600 mt-4 max-w-2xl">
            History converges at the present; the future cone expands right. Scenarios sit on
            horizon rings by likelihood. The bold line is a preferred trajectory; diverging lines
            are off-ramps. Showing the Sovereign Canada foresight storyline.
          </Text>
          {
            showcaseScope ? (
              <div class="mt-8 border border-base-200 bg-base-50" style="height: 640px;">
                <ForesightScope client:only="react" data={showcaseScope} />
              </div>
            ) : (
              <Text tag="p" variant="textSM" class="text-base-600 mt-8">
                Foresight Scope data is unavailable for this storyline.
              </Text>
            )
          }
          <Text tag="p" variant="textXS" class="text-base-400 mt-4">
            <a href="/storylines/sovereign-canada" class="text-accent-600 hover:underline">
              Full Sovereign Canada storyline &rarr;
            </a>
            {" · "}
            <a
              href="https://canada2080.org/"
              class="text-accent-600 hover:underline"
              target="_blank"
              rel="noopener"
            >
              Canada2080.org
            </a>
          </Text>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
