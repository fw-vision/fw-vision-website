---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Use || so empty GitHub Actions vars still fall back to live defaults (?? only skips null/undefined).
const listmonkUrl = (import.meta.env.PUBLIC_LISTMONK_URL || "https://fwvision-elitemini-series.tail0f7891.ts.net").replace(/\/$/, "");
const listmonkListUuid = import.meta.env.PUBLIC_LISTMONK_LIST_UUID || "2e695404-3067-4d75-9e09-e618b0b2b39c";
const subscribeEnabled = Boolean(listmonkUrl && listmonkListUuid);

const engagementTiers = [
  {
    title: "Signals",
    description: "Cross-domain futures analysis, framework previews, and signal alerts delivered to your inbox.",
    price: "Complimentary",
    buttonVariant: "muted",
    buttonText: "Subscribe",
    href: "#newsletter",
  },
  {
    title: "Research Access",
    description: "Workshop engagements and structured consulting. Proprietary methodology applied to your organisational context.",
    price: "Contact for details",
    buttonVariant: "accent",
    buttonText: "Enquire",
    href: "mailto:francis.wang@fw.vision?subject=Research%20Access%20Enquiry",
  },
  {
    title: "Governance Partnership",
    description: "Retained long-horizon advisory. Strategic fund governance architecture, institutional foresight integration, and ongoing scenario analysis.",
    price: "Bespoke engagement",
    buttonVariant: "muted",
    buttonText: "Enquire",
    href: "mailto:francis.wang@fw.vision?subject=Governance%20Partnership%20Enquiry",
  },
];

const workshops = [
  {
    title: "Agentic AI Maturity Assessment",
    description: "Most organisations stall at AI tooling adoption without crossing the chasm into agentic operations. This structured assessment evaluates organisational readiness across six dimensions (Leadership, Talent, Data, Infrastructure, Governance, Culture) using the AI Adoption Maturity Model. Identifies the specific barriers preventing your organisation from progressing from Tier 1 (tool-assisted) through Tier 2 (augmented workflows) to Tier 3 (fully agentic operations). Delivers a prioritised roadmap for crossing the chasm.",
  },
  {
    title: "Business Process Mapping for AI Integration",
    description: "Event Storming and Domain-Driven Design methodology applied to cross-department workflow visualisation. Maps past-tense events, triggers, handoffs, and bounded contexts into an interactive process map. Identifies automation candidates, friction points, and AI-integration opportunities. Produces agent delegation specifications with clear contracts between human and AI responsibilities.",
  },
  {
    title: "Policy-as-Code Design",
    description: "Encoding governance rules, operational boundaries, and strategic constraints into machine-readable policy. Enables AI agents to execute within founding intent without continuous human supervision. Covers rule specification, exception handling, audit trails, and evolution protocols. Produces versioned, testable governance artifacts.",
  },
  {
    title: "Agent Fleet Composition",
    description: "Designing the AI workforce: which agents, what specialisations, how they coordinate, what they report on, how they evolve. Tailored to the organisation's operational structure and strategic needs. Covers agent role definition, skill architecture, orchestration patterns, quality assurance, and fleet evolution cycles.",
  },
];

const faqData = [
  {
    question: "What is the typical engagement timeline?",
    answer: "Assessment engagements are typically 1-2 days. Workshop series run 3-6 sessions over 4-8 weeks. Governance partnerships are retained annually with quarterly review cycles.",
  },
  {
    question: "Is published research gated behind a subscription?",
    answer: "All FW.VISION research, frameworks, and lexicon entries are published openly. The Signals newsletter delivers curated analysis directly. Consulting engagements apply proprietary methodology to your specific context.",
  },
  {
    question: "How does the workshop series connect?",
    answer: "The Maturity Assessment establishes baseline and roadmap. Process Mapping identifies where AI integration adds most value. Policy-as-Code encodes governance for those integrations. Fleet Composition designs the agent workforce that operates within those policies. Each workshop builds on the previous, but they can be engaged independently.",
  },
  {
    question: "What industries does FW.VISION work with?",
    answer: "The frameworks are sector-agnostic but particularly relevant for strategic funds, policy organisations, innovation agencies, venture studios, and any knowledge-intensive institution seeking to operationalise AI at the governance level rather than just the productivity level.",
  },
  {
    question: "How does FW.VISION differ from traditional AI consultancies?",
    answer: "Traditional AI consultancies implement tools. FW.VISION architects governance. The distinction: tool implementation asks 'what AI can we deploy?' Governance architecture asks 'how do we encode institutional intent so AI operates within it?' The output is not a deployed model but an organisational operating system.",
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-8">
        <div class="lg:pr-8">
          <div class="lg:sticky lg:top-20 lg:z-50">
            <Text
              tag="h1"
              variant="textSM"
              class="text-base-900 uppercase font-medium"
            >
              Signals &amp; Engagement
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-base-600 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
            >
              Signals newsletter, consulting workshops, and governance advisory. All published research is freely accessible. For engagement enquiries, use Engage.
            </Text>
          </div>
        </div>
        <div
          class="lg:col-span-2 lg:pl-8 lg:relative lg:before:absolute lg:after:absolute
              lg:before:bg-base-950 lg:after:bg-base-950/10 lg:before:top-0
              lg:before:left-0 lg:before:h-6 lg:before:w-px lg:after:top-8
              lg:after:bottom-0 lg:after:left-0 after:w-px"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
            {
              engagementTiers.map((tier) => (
                <div class="bg-base-50 p-6 rounded-xl flex flex-col justify-between gap-8">
                  <div>
                    <Text
                      tag="h3"
                      variant="textBase"
                      class="font-medium font-display text-base-900"
                    >
                      {tier.title}
                    </Text>
                    <Text tag="p" variant="textSM" class="text-base-600 mt-1">
                      {tier.description}
                    </Text>
                    <Text tag="p" variant="textBase" class="font-semibold mt-4 text-base-900">
                      {tier.price}
                    </Text>
                  </div>
                  <Button isLink type="button" size="xs" variant={tier.buttonVariant} href={tier.href}>
                    {tier.buttonText}
                  </Button>
                </div>
              ))
            }
          </div>

          <section class="mt-12">
            <Text
              tag="h2"
              variant="textSM"
              class="text-base-900 uppercase font-medium"
            >
              Workshop Series
            </Text>
            <Text tag="p" variant="textXS" class="text-base-600 mt-1">
              Structured engagements that bring organisations from AI tooling adoption across the chasm into agentic operations.
            </Text>
            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-6 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
            >
              {
                workshops.map((workshop, index) => (
                  <div class="p-4 rounded-lg bg-base-50">
                    <Text tag="p" variant="textXS" class="text-accent-600 font-medium">
                      {String(index + 1).padStart(2, '0')}
                    </Text>
                    <Text tag="h3" variant="textSM" class="text-base-900 font-medium mt-1">
                      {workshop.title}
                    </Text>
                    <Text tag="p" variant="textXS" class="text-base-600 mt-2">
                      {workshop.description}
                    </Text>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="mt-12" id="newsletter">
            <Text
              tag="h2"
              variant="textSM"
              class="text-base-900 uppercase font-medium"
            >
              Signals Newsletter
            </Text>
            <div class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2">
              <Text tag="p" variant="textSM" class="text-base-600">
                Cross-domain futures analysis, framework updates, and foresight signals. Published when substance warrants it, not on a fixed schedule.
              </Text>
              <div class="mt-4 rounded-lg bg-base-100 p-5">
                {
                  subscribeEnabled ? (
                    <>
                      <Text tag="p" variant="textSM" class="font-medium text-base-900">
                        Subscribe to Signals
                      </Text>
                      <Text tag="p" variant="textXS" class="mt-2 text-base-600">
                        Double opt-in. After you subscribe, check your email to confirm. Confirmation mail depends on mail being configured. You can unsubscribe from any message. See the{" "}
                        <a class="text-accent-700 hover:underline" href="/legal/privacy">
                          privacy notice
                        </a>
                        .
                      </Text>
                      <form
                        id="signals-subscribe-form"
                        class="mt-4 flex flex-col sm:flex-row gap-2"
                      >
                        <label class="sr-only" for="signals-email">Email</label>
                        <input
                          id="signals-email"
                          name="email"
                          type="email"
                          required
                          autocomplete="email"
                          placeholder="you@example.com"
                          class="flex-1 min-w-0 rounded-md border border-base-300 bg-white px-3 py-2 text-sm text-base-900"
                        />
                        <label class="sr-only" for="signals-name">Name</label>
                        <input
                          id="signals-name"
                          name="name"
                          type="text"
                          autocomplete="name"
                          placeholder="Name (optional)"
                          class="flex-1 min-w-0 rounded-md border border-base-300 bg-white px-3 py-2 text-sm text-base-900"
                        />
                        <Button type="submit" size="xs" variant="accent">
                          Subscribe
                        </Button>
                      </form>
                      <p id="signals-subscribe-status" class="mt-3 text-xs text-base-600" aria-live="polite"></p>
                      <script define:vars={{ listmonkUrl, listmonkListUuid }}>
                        const form = document.getElementById("signals-subscribe-form");
                        const status = document.getElementById("signals-subscribe-status");
                        if (form && status) {
                          form.addEventListener("submit", async (event) => {
                            event.preventDefault();
                            status.textContent = "Submitting…";
                            status.classList.remove("text-accent-700", "text-red-700");
                            status.classList.add("text-base-600");
                            const data = new FormData(form);
                            const email = String(data.get("email") || "").trim();
                            const name = String(data.get("name") || "").trim();
                            const payload = {
                              email,
                              list_uuids: [listmonkListUuid],
                            };
                            if (name) payload.name = name;
                            try {
                              const response = await fetch(`${listmonkUrl}/api/public/subscription`, {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify(payload),
                              });
                              if (!response.ok) {
                                const body = await response.text();
                                throw new Error(body || `HTTP ${response.status}`);
                              }
                              status.classList.remove("text-base-600", "text-red-700");
                              status.classList.add("text-accent-700");
                              status.textContent =
                                "Request received. Check your email to confirm the subscription. If no message arrives, confirmation mail may not be configured yet; email francis.wang@fw.vision.";
                              form.reset();
                            } catch (error) {
                              status.classList.remove("text-base-600", "text-accent-700");
                              status.classList.add("text-red-700");
                              status.textContent =
                                "Subscription could not be completed. Please try again or email francis.wang@fw.vision.";
                              console.error(error);
                            }
                          });
                        }
                      </script>
                    </>
                  ) : (
                    <>
                      <Text tag="p" variant="textSM" class="font-medium text-base-900">Email collection is currently disabled.</Text>
                      <Text tag="p" variant="textXS" class="mt-2 text-base-600">Follow the public <a class="text-accent-700 hover:underline" href="/rss.xml">RSS feed</a> or contact <a class="text-accent-700 hover:underline" href="mailto:francis.wang@fw.vision">francis.wang@fw.vision</a>.</Text>
                    </>
                  )
                }
              </div>
            </div>
          </section>

          <section class="mt-12">
            <Text
              tag="h2"
              variant="textSM"
              class="text-base-900 uppercase font-medium"
            >
              Frequently Asked Questions
            </Text>
            <ul
              class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
            >
              <div class="space-y-4">
                {
                  faqData.map((faq) => (
                    <details class="select-none">
                      <summary class="text-base-900 font-medium font-display cursor-pointer">
                        {faq.question}
                      </summary>
                      <div class="border-t border-base-200 pt-2 pb-8">
                        <Text tag="p" variant="textSM" class="text-base-600">
                          {faq.answer}
                        </Text>
                      </div>
                    </details>
                  ))
                }
              </div>
            </ul>
          </section>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
