---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-y-8">
        <div class="lg:pr-8">
          <div class="lg:sticky lg:top-20 lg:z-50">
            <Text
              tag="h1"
              variant="textBase"
              class="text-base-900 font-display font-medium"
            >
              Engage with FW.VISION
            </Text>
            <Text tag="p" variant="textSM" class="text-base-600 mt-2">
              For consulting engagements, governance advisory, or workshop enquiries.
            </Text>

            <div
              class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-4"
            >
              <Text
                tag="h3"
                variant="textSM"
                class="text-base-900 font-medium font-display"
              >
                Calgary, Canada
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 mt-2">
                Remote-first operations with physical presence in Calgary, Alberta.
              </Text>
              <div class="mt-4">
                <Text tag="p" variant="textXS">
                  <a
                    href="mailto:francis.wang@fw.vision"
                    class="text-accent-600 hover:underline"
                  >
                    francis.wang@fw.vision
                  </a>
                </Text>
              </div>
              <div class="mt-2">
                <Text tag="p" variant="textXS">
                  <a
                    href="https://linkedin.com/in/congwang"
                    class="text-base-600 hover:underline"
                    target="_blank"
                  >
                    LinkedIn
                  </a>
                </Text>
              </div>
            </div>

            <div
              class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-4"
            >
              <Text tag="h3" variant="textSM" class="text-base-900 font-medium font-display">
                Engagement Types
              </Text>
              <ul class="mt-2 space-y-1">
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600">
                    Agentic AI Maturity Assessment
                  </Text>
                </li>
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600">
                    Business Process Mapping Workshops
                  </Text>
                </li>
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600">
                    Policy-as-Code Design
                  </Text>
                </li>
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600">
                    Agent Fleet Composition
                  </Text>
                </li>
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600">
                    Strategic Fund Governance Advisory
                  </Text>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div
          class="lg:col-span-2 lg:pl-8 lg:relative lg:before:absolute lg:after:absolute
        lg:before:bg-base-950 lg:after:bg-base-950/10 lg:before:top-0
        lg:before:left-0 lg:before:h-6 lg:before:w-px lg:after:top-8
        lg:after:bottom-0 lg:after:left-0 after:w-px"
        >
          <div class="max-w-lg">
            <Text tag="h2" variant="displaySM" class="text-base-900 font-display font-medium">
              How FW.VISION Engages
            </Text>
            <div class="mt-8 space-y-6 text-sm text-base-600">
              <p>
                FW.VISION operates as a founder-led consultancy and think tank. Engagements are structured as workshops, advisory retainers, or governance design projects. All intellectual output (frameworks, research, scenarios) remains openly published. Client-specific governance architecture and strategic recommendations are confidential.
              </p>
              <p>
                The firm does not employ account managers, sales teams, or business development representatives. All engagement enquiries are handled directly by the founder. This is deliberate: it ensures alignment between the intellectual infrastructure and its application.
              </p>
              <div class="mt-8">
                <Text tag="h3" variant="textBase" class="text-base-900 font-medium">
                  Workshop Engagements
                </Text>
                <p class="mt-2">
                  Structured, intensive sessions applying FW.VISION frameworks to client-specific contexts. Typically 1-3 days. Deliverables include process maps, maturity assessments, governance architecture documents, and implementation roadmaps.
                </p>
              </div>
              <div class="mt-6">
                <Text tag="h3" variant="textBase" class="text-base-900 font-medium">
                  Governance Advisory
                </Text>
                <p class="mt-2">
                  Retained advisory for strategic funds and institutional actors requiring long-horizon governance architecture. Quarterly governance reviews, scenario updates, and portfolio-level strategic direction.
                </p>
              </div>
              <div class="mt-6">
                <Text tag="h3" variant="textBase" class="text-base-900 font-medium">
                  Venture Incubation
                </Text>
                <p class="mt-2">
                  Submit a venture concept as a one-page brief to Horizon Studio. FW.VISION evaluates alignment with futures worth actualising, provides governance architecture, and co-develops ventures through the Futures Foundry pipeline.
                </p>
              </div>
            </div>
            <div class="mt-12 p-6 bg-base-100 rounded-xl">
              <Text tag="h3" variant="textSM" class="text-base-900 font-medium">
                Ready to engage?
              </Text>
              <Text tag="p" variant="textXS" class="text-base-600 mt-2">
                Describe your challenge, timeline, and desired outcome. FW.VISION responds to all enquiries within 48 hours.
              </Text>
              <a
                href="mailto:francis.wang@fw.vision?subject=FW.VISION%20Engagement%20Enquiry"
                class="inline-block mt-4 px-4 py-2 text-sm font-medium text-white bg-accent-600 hover:bg-accent-700 rounded-lg transition duration-300"
              >
                Send Enquiry
              </a>
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
