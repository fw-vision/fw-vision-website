---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const columns = (await getCollection("posts"))
  .filter(({ data }) => data.contentType === "column" && data.editorialStatus === "published")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <Wrapper variant="standard" class="py-16">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent-700">Signed interpretation</p>
    <h1 class="mt-3 font-display text-5xl text-base-950">Francis Wang columns</h1>
    <p class="mt-4 max-w-2xl text-xl text-base-600">Arguments connecting present signals to structural choices, scenarios, and long-horizon consequences.</p>
    <div class="mt-12 divide-y divide-base-200 border-y border-base-200">
      {columns.map((column) => <article class="py-8"><p class="text-xs uppercase tracking-wide text-base-500">{column.data.pubDate.toLocaleDateString("en-CA")}</p><h2 class="mt-2 font-display text-3xl text-base-950"><a class="hover:text-accent-700" href={`/commentary/${column.id}/`}>{column.data.title}</a></h2><p class="mt-3 max-w-3xl text-base-600">{column.data.description}</p></article>)}
    </div>
  </Wrapper>
</BaseLayout>
