---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard2 from "@/components/blog/BlogCard2.astro";
import BlogAside from "@/components/blog/BlogAside.astro";
import AdvertAside from "@/components/advert/AdvertAside.astro";
// Content
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
// Sort posts by date
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA; // Compare timestamps
});
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-0">
        <div class="lg:col-span-3 lg:pr-8">
          <Text
            tag="h2"
            variant="textXS"
            class="text-base-900 uppercase font-medium"
          >
            Subscribers only
          </Text>
          <div
            class="flex flex-col gap-8 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-2"
          >
            {
              allPosts
                .filter((post) => post.data.isLocked)
                .map((post) => <BlogCard2 post={post} />)
            }
          </div>
          <div class="mt-12 rounded-xl bg-base-100 p-6">
            <Text tag="h3" variant="textSM" class="text-base-900 font-medium">
              Subscribe to Signals
            </Text>
            <Text tag="p" variant="textXS" class="text-base-600 mt-2">
              Locked posts will open as Signals membership access ships. Until then,
              <a href="/subscribe" class="text-accent-700 hover:underline">subscribe to Signals</a>
              or follow the
              <a href="/rss.xml" class="text-accent-700 hover:underline">RSS feed</a>.
            </Text>
          </div>
        </div>
        <div
          class="lg:pl-8 lg:relative lg:before:absolute lg:after:absolute
        lg:before:bg-base-950 lg:after:bg-base-950/10 lg:before:top-0
        lg:before:left-0 lg:before:h-6 lg:before:w-px lg:after:top-8
        lg:after:bottom-0 lg:after:left-0 after:w-px"
        >
          <div class="lg:sticky lg:top-10 lg:z-50">
            <BlogAside />
            <AdvertAside />
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
