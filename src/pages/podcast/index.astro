---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="max-w-lg">
        <Text tag="h1" variant="displaySM" class="text-base-900 font-display font-medium">
          Futures Conversations
        </Text>
        <div class="relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4 mt-4">
          <Text tag="p" variant="textSM" class="text-base-600">
            Long-form conversations with institutional architects, fund managers, and domain experts operating on long horizons. Launching Q3 2026.
          </Text>
          <Text tag="p" variant="textXS" class="text-base-400 mt-4">
            Subscribe to Signals to be notified when episodes begin publishing.
          </Text>
          <a href="/subscribe" class="inline-block mt-4 text-xs text-accent-600 hover:underline">
            Subscribe to Signals →
          </a>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
