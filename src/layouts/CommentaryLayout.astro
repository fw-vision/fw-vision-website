---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SourceRecord from "@/components/signals/SourceRecord.astro";

interface Props {
  entry: CollectionEntry<"posts">;
  authorName: string;
  relatedSignals: CollectionEntry<"posts">[];
}

const { entry, authorName, relatedSignals } = Astro.props;
const { data } = entry;
---

<BaseLayout>
  <article>
    <Wrapper variant="standard" class="py-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-700">Francis Wang column</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-medium text-base-950 lg:text-6xl">{data.title}</h1>
      <p class="mt-5 max-w-3xl text-xl text-base-600">{data.description}</p>
      <div class="mt-5 text-sm text-base-600">Signed by {authorName} · {data.pubDate.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" })}</div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div class="prose prose-slate max-w-none"><slot /></div>
        <aside class="space-y-6">
          {relatedSignals.length > 0 && (
            <section>
              <h2 class="text-sm font-semibold uppercase tracking-wide text-base-900">Signals considered</h2>
              <ul class="mt-3 space-y-3 text-sm">
                {relatedSignals.map((signal) => <li><a class="text-accent-700 hover:underline" href={`/signals/${signal.id}/`}>{signal.data.title}</a></li>)}
              </ul>
            </section>
          )}
          {data.sourceRecords?.map((source) => <SourceRecord sourceRecord={source} />)}
        </aside>
      </div>
    </Wrapper>
  </article>
</BaseLayout>
